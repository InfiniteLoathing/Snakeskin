<Project>
    <PropertyGroup>
        <Compile Condition="'$(CompileExports)' == ''">false</Compile>
    </PropertyGroup>
    <ItemGroup>
        <AdditionalFiles Include="**\*.snakeskin.cs" />
        <Compile Remove="**\*.snakeskin.cs"
                 Condition="'$(CompileExports)' != 'true'" />
        <None Include="**\*.snakeskin.cs"
              Exclude="@(None)"
              Condition="'$(CompileExports)' != 'true'" />
    </ItemGroup>
</Project>